+import { defineWidgetType } from '@project-board/widget-sdk';
+import CounterWidget from './CounterWidget';
+import { migrateCounterV1 } from './model';
+
+export function createCounterModule() {
+  return { widgetTypes: [defineWidgetType({
+    id: 'counter-example', title: 'Счётчик (пример)', icon: 'lucide:list-todo',
+    description: 'Учебный виджет: общий документ и настройки окна',
+    component: CounterWidget, startSettings: { compact: false },
+    sizeConstraints: { minWidth: 2, minHeight: 2 },
+    documentSupport: {
+      moduleId: 'counter-example', documentType: 'counter', schemaVersion: 2,
+      createContent: () => ({ count: 0 }),
+      migrations: [{ from: 1, to: 2, migrate: migrateCounterV1 }],
+    },
+  })] };
+}
diff --git a/packages/counter-widget/src/model.test.ts b/packages/counter-widget/src/model.test.ts
new file mode 100644
index 0000000..3a42fb0
--- /dev/null
+++ b/packages/counter-widget/src/model.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { migrateCounterV1, parseCounter } from './model';
+
+describe('документ учебного счётчика', () => {
+  it('читает целое значение, включая ноль', () => {
+    expect(parseCounter({ count: 0 })).toEqual({ count: 0 });
+    expect(parseCounter({ count: -5 })).toEqual({ count: -5 });
+  });
+  it('отвергает повреждённые данные и переполнение вместо сброса', () => {
+    for (const content of [null, {}, { count: '2' }, { count: 0.5 }, { count: Number.MAX_SAFE_INTEGER + 1 }]) {
+      expect(() => parseCounter(content)).toThrow();
+    }
+  });
+  it('мигрирует v1 без изменения входного объекта и не теряет ошибку', () => {
+    const legacy = Object.freeze({ value: 7 });
+    expect(migrateCounterV1(legacy)).toEqual({ count: 7 });
+    expect(legacy).toEqual({ value: 7 });
+    expect(() => migrateCounterV1({ value: 'bad' })).toThrow();
+  });
+});
diff --git a/packages/counter-widget/src/model.ts b/packages/counter-widget/src/model.ts
new file mode 100644
index 0000000..7caebb3
--- /dev/null
+++ b/packages/counter-widget/src/model.ts
@@ -0,0 +1,17 @@
+export interface CounterContent { readonly count: number }
+
+export function parseCounter(content: unknown): CounterContent {
+  if (typeof content !== 'object' || content === null ||
+      !('count' in content) || !Number.isSafeInteger(content.count)) {
+    throw new Error('Документ счётчика должен содержать целое безопасное число count.');
+  }
+  return { count: content.count as number };
+}
+
+/** Чистая миграция прежнего формата { value } в { count }. */
+export function migrateCounterV1(content: unknown): CounterContent {
+  if (typeof content !== 'object' || content === null || !('value' in content)) {
+    throw new Error('В документе счётчика v1 отсутствует value.');
+  }
+  return parseCounter({ count: content.value });
+}
