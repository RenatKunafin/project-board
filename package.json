{
  "name": "project-board-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/project-board",
    "dev:spike": "npm run dev -w apps/gantt-spike",
    "dev:resource-spike": "npm run dev -w apps/resource-timeline-spike",
    "build": "npm run build -w apps/project-board",
    "preview": "npm run preview -w apps/project-board",
    "typecheck": "tsc --noEmit -p apps/project-board && tsc --noEmit -p packages/widget-sdk && tsc --noEmit -p packages/dashboard && tsc --noEmit -p packages/gantt && tsc --noEmit -p packages/checklist && tsc --noEmit -p apps/gantt-spike && tsc --noEmit -p apps/resource-timeline-spike",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
